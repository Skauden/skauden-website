{
  // Cloudflare Workers config: serve the Astro build (dist/) as a static site.
  "name": "skauden-website",
  "compatibility_date": "2025-09-01",
  // Serve only on skauden.com (custom domain set in the dashboard),
  // not on the free *.workers.dev address or per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
